Screen { background: #101b20; color: #e7ece7; padding: 1 0; }
#workspace { height: 1fr; padding: 0 1; }
#navigation { width: 28; height: 1fr; margin-right: 1; }
#sequence-heading { height: auto; border: round #40565d; background: #18252b; padding: 1; margin-bottom: 1; }
#lesson-navigation { height: 1fr; border: round #40565d; background: #18252b; padding: 1; }
#sequence-context { height: auto; color: #94a9ad; }
#lesson-list { height: 1fr; background: transparent; border: none; padding: 0; }
#lesson-list .option-list--option { padding: 0; }
#nav-hint { height: auto; color: #94a9ad; }
#primary { width: 1fr; height: 1fr; margin-right: 1; }
MaterialPane { height: 1fr; padding: 1 2; background: #18252b; border: round #40565d; overflow-x: hidden; scrollbar-size: 1 1; scrollbar-color: #678e80; scrollbar-background: #18252b; }
MaterialPane:focus { border: round #a9d6bf; }
#orientation { width: 44; height: 1fr; }
#goals { height: 14; margin-bottom: 1; }
#schedule { height: 1fr; }
.section-title { height: auto; margin-bottom: 1; color: #a9d6bf; text-style: bold; }
#goal { height: auto; }
#plan { height: auto; }
Material { height: auto; width: 1fr; overflow: hidden hidden; }
Markdown { background: #18252b; padding: 0; margin: 0; height: auto; }
MarkdownH1 { background: transparent; color: #a9d6bf; border: none; padding: 0; margin: 0 0 1 0; text-style: bold; text-align: left; }
MarkdownH2 { border: none; padding: 0; margin: 1 0 1 0; color: #a9d6bf; }
MarkdownParagraph { margin: 0 0 1 0; }
.formula { margin: 0 0 1 0; }
.figure { margin: 0; }
.formula, .figure { overflow: hidden hidden; }
.formula > Widget, .figure > Widget { width: 100%; height: 100%; overflow: hidden hidden; }
.inline-flow { height: auto; min-height: 1; margin-bottom: 1; }
.inline-math { height: auto; margin-bottom: 0; align-vertical: middle; overflow: hidden hidden; }
.inline-math .formula { margin: 0 1; }
.inline-text { width: auto; height: auto; }
.caption { height: auto; color: #94a9ad; margin-bottom: 1; }
.text-fallback { height: auto; padding: 1; margin-bottom: 1; color: #e9caa8; }
.task-title { height: auto; text-style: bold; color: #a9d6bf; border-top: solid #40565d; padding-top: 1; margin-bottom: 1; }
.solution-title { height: 1; color: #94a9ad; margin: 1 0; }
#status { height: 1; color: #94a9ad; padding: 0 3; margin-top: 1; }
Footer { background: #203239; }
