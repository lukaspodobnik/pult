SequenceLibraryScreen #sequence-library {
    height: 1fr;
}

SequenceLibraryScreen #sequence-navigation {
    width: 36;
    padding: 1;
    background: $background;
}

SequenceLibraryScreen #sequence-tree {
    height: 1fr;
    border: round $primary;
    border-title-color: $text-accent;
}

SequenceLibraryScreen #sequence-content {
    width: 1fr;
    padding: 1 2;
}

SequenceLibraryScreen #sequence-preview {
    height: 1fr;
    padding: 1 2;
    background: $surface;
    border: round $primary;
    border-title-color: $text-accent;
}

SequenceLibraryScreen #sequence-tree,
SequenceLibraryScreen #sequence-preview {
    background-tint: transparent;
    outline: none;
    border-title-style: none;
}

SequenceLibraryScreen #sequence-tree:focus,
SequenceLibraryScreen #sequence-preview:focus {
    border: round $primary-lighten-2;
    border-title-color: $primary-lighten-2;
    border-title-style: bold;
    background-tint: transparent;
    outline: none;
}

App.-light-mode SequenceLibraryScreen #sequence-tree:focus,
App.-light-mode SequenceLibraryScreen #sequence-preview:focus {
    border: round $primary-darken-2;
    border-title-color: $primary-darken-2;
}

SequencePreview > .option-list--option {
    padding: 0 1;
    color: $text;
    background: transparent;
}

SequencePreview > .option-list--option-disabled {
    color: $text-muted;
    background: transparent;
}

SequencePreview > .option-list--option-highlighted,
SequencePreview > .option-list--option-hover-highlighted,
SequencePreview > .option-list--option-hover {
    color: $text;
    background: transparent;
    text-style: none;
}

SequencePreview:focus > .option-list--option-highlighted,
SequencePreview:focus > .option-list--option-hover-highlighted {
    color: $text;
    background: $primary 16%;
    text-style: none;
}

SequencePreview:blur > .option-list--option-highlighted,
SequencePreview:blur > .option-list--option-hover-highlighted,
SequencePreview:blur > .option-list--option-hover {
    background: transparent;
    text-style: none;
}
