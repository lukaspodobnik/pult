LessonProgressBar {
    width: 1fr;
    height: 1;

    & > .lesson-progress-bar--completed {
        color: $success;
    }

    & > .lesson-progress-bar--skipped {
        color: $warning;
    }

    & > .lesson-progress-bar--open {
        color: $surface-lighten-2;
    }
}

SchoolClassView {
    height: 1fr;
}

SchoolClassView #school-class-content {
    height: 1fr;
}

SchoolClassView .subject-progress {
    height: 1fr;
    min-height: 34;
    min-width: 120;
}

SchoolClassView .subject-overview,
SchoolClassView .sequence-list,
SchoolClassView .class-next-lesson,
SchoolClassView .class-last-entry,
SchoolClassView .lesson-capacity {
    background: $surface;
    border: round $primary;
    border-title-color: $text-accent;
    padding: 0 1 0 2;
}

SchoolClassView .subject-overview {
    height: 4;
    margin-bottom: 1;
}

SchoolClassView .total-label {
    height: 1;
}

SchoolClassView .class-dashboard {
    height: 1fr;
}

SchoolClassView .sequence-list {
    padding: 1 0 0 2;
    width: 1fr;
    height: 1fr;
    min-height: 12;
    max-height: 28;
}

SchoolClassView .class-details {
    width: 3fr;
    margin-right: 1;
    height: 1fr;
}

SchoolClassView .class-context {
    width: 2fr;
    height: 1fr;
    overflow-x: hidden;
}

SchoolClassView .class-last-entry {
    height: auto;
    margin-top: 1;
}

SchoolClassView .class-next-lesson,
SchoolClassView .class-last-entry {
    height: auto;
    padding: 1 2;
}

SchoolClassView .next-lesson-materials,
SchoolClassView .next-lesson-material {
    height: auto;
}

SchoolClassView .next-lesson-material-label {
    height: 1;
    text-style: bold;
}

SchoolClassView .next-lesson-materials {
    margin-top: 1;
    border-top: solid $primary;
}

SchoolClassView .next-lesson-material-list {
    height: auto;
    max-height: 8;
    overflow-x: hidden;
}

SchoolClassView .next-lesson-title,
SchoolClassView .last-entry-title {
    height: auto;
    margin-top: 1;
    text-style: bold;
}

SchoolClassView .last-entry-metadata {
    height: auto;
    align-vertical: top;
}

SchoolClassView .last-entry-date {
    width: 1fr;
}

SchoolClassView .last-entry-action {
    width: auto;
    max-width: 20;
    height: auto;
    margin-left: 2;
    padding: 0 1;
    background: $boost;
    text-style: bold;
}

SchoolClassView .next-lesson-sequence,
SchoolClassView .next-lesson-assessment-topic,
SchoolClassView .class-assessment-topic,
SchoolClassView .last-entry-sequence,
SchoolClassView .last-entry-comment {
    height: auto;
}

SchoolClassView .last-entry-comment {
    margin-top: 1;
}

SchoolClassView .last-entry-comment {
    border-left: solid $primary;
    padding-left: 2;
}

SchoolClassView .next-lesson-date,
SchoolClassView .next-lesson-empty,
SchoolClassView .next-lesson-sequence,
SchoolClassView .last-entry-date,
SchoolClassView .last-entry-empty,
SchoolClassView .last-entry-sequence,
SchoolClassView .class-assessment-date,
SchoolClassView .held-lessons,
SchoolClassView .empty-sequence-hint {
    height: auto;
    color: $foreground-muted;
}

SchoolClassView .progress-heading {
    height: 1;
}

SchoolClassView .progress-title {
    width: 1fr;
    height: 1;
}

SchoolClassView .progress-count {
    width: auto;
    min-width: 9;
    height: auto;
    text-align: right;
}

SchoolClassView .lesson-capacity {
    height: 8;
    min-height: 8;
    margin-top: 1;
    padding: 1 2;
}

SchoolClassView .outlook-columns {
    height: 4;
}

SchoolClassView .capacity-figure {
    width: 19;
    height: 4;
    margin-right: 2;
    padding-right: 2;
    border-right: solid $primary;
}

SchoolClassView .capacity-label,
SchoolClassView .capacity-caption {
    height: 1;
    color: $foreground-muted;
}

SchoolClassView .lesson-balance {
    height: 1;
    text-style: bold;
}

SchoolClassView .lesson-balance.positive {
    color: $success;
}

SchoolClassView .lesson-balance.negative {
    color: $error;
}

SchoolClassView .sequence-progress {
    height: auto;
    margin-right: 1;
    margin-bottom: 1;
}

SchoolClassView .sequence-progress.active {
    color: $text-accent;
}

SchoolClassView .sequence-progress.active .progress-heading,
SchoolClassView .sequence-progress.active .progress-title {
    height: auto;
}

SchoolClassView .class-assessment-label {
    height: 1;
    color: $foreground-muted;
}

SchoolClassView .class-assessment-details {
    width: 1fr;
    height: 4;
}

SchoolClassView .class-assessment {
    height: auto;
    text-style: bold;
}
