LessonProgressBar {
    width: 1fr;
    height: 1;

    & > .lesson-progress-bar--completed {
        color: $success;
    }

    & > .lesson-progress-bar--skipped {
        color: $warning;
    }

    & > .lesson-progress-bar--open {
        color: $surface-lighten-2;
    }
}

SchoolClassView {
    height: 1fr;
}

SchoolClassView #school-class-content {
    height: 1fr;
}

SchoolClassView .subject-progress {
    height: 1fr;
    min-height: 34;
    min-width: 120;
}

SchoolClassView .subject-overview,
SchoolClassView .sequence-list,
SchoolClassView .class-next-lesson,
SchoolClassView .class-last-entry,
SchoolClassView .lesson-capacity {
    background: $surface;
    border: round $primary;
    border-title-color: $text-accent;
    padding: 0 1 0 2;
}

SchoolClassView .subject-overview {
    height: 4;
    margin-bottom: 1;
}

SchoolClassView .total-label {
    height: 1;
}

SchoolClassView .class-dashboard {
    height: 1fr;
}

SchoolClassView .sequence-list {
    padding: 1 0 0 2;
    width: 1fr;
    height: 1fr;
    min-height: 12;
    max-height: 28;
}

SchoolClassView .class-details {
    width: 3fr;
    margin-right: 1;
    height: 1fr;
}

SchoolClassView .class-context {
    width: 2fr;
    height: 1fr;
}

SchoolClassView .lesson-capacity,
SchoolClassView .class-last-entry {
    height: auto;
    margin-top: 1;
}

SchoolClassView .class-next-lesson {
    height: auto;
}

SchoolClassView .next-lesson-title,
SchoolClassView .last-entry-title,
SchoolClassView .last-entry-action {
    height: auto;
    text-style: bold;
}

SchoolClassView .next-lesson-sequence,
SchoolClassView .last-entry-sequence,
SchoolClassView .last-entry-comment,
SchoolClassView .last-entry-hint {
    height: auto;
}

SchoolClassView .last-entry-comment,
SchoolClassView .last-entry-hint {
    margin-top: 1;
}

SchoolClassView .next-lesson-date,
SchoolClassView .next-lesson-empty,
SchoolClassView .next-lesson-sequence,
SchoolClassView .last-entry-date,
SchoolClassView .last-entry-empty,
SchoolClassView .last-entry-sequence,
SchoolClassView .last-entry-hint,
SchoolClassView .held-lessons,
SchoolClassView .empty-sequence-hint {
    height: auto;
    color: $foreground-muted;
}

SchoolClassView .progress-heading {
    height: 1;
}

SchoolClassView .progress-title {
    width: 1fr;
    height: 1;
}

SchoolClassView .progress-count {
    width: auto;
    min-width: 9;
    height: auto;
    text-align: right;
}

SchoolClassView .capacity-row {
    height: 1;
}

SchoolClassView .capacity-label {
    width: 1fr;
    height: 1;
}

SchoolClassView .capacity-value {
    width: 12;
    height: 1;
    text-align: right;
}

SchoolClassView .lesson-balance {
    text-style: bold;
}

SchoolClassView .lesson-balance.positive {
    color: $success;
}

SchoolClassView .lesson-balance.negative {
    color: $error;
}

SchoolClassView .lesson-balance.neutral {
    color: $foreground-muted;
}

SchoolClassView .sequence-progress {
    height: auto;
    margin-right: 1;
    margin-bottom: 1;
}

SchoolClassView .sequence-progress.active {
    color: $text-accent;
}

SchoolClassView .sequence-progress.active .progress-heading,
SchoolClassView .sequence-progress.active .progress-title {
    height: auto;
}

SchoolClassView .class-assessment-label {
    height: 1;
    margin-top: 1;
    color: $foreground-muted;
}

SchoolClassView .class-assessment { height: auto; margin-bottom: 1; }
