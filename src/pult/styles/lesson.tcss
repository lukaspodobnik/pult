LessonScreen { padding: 1 0 0 0; }
LessonScreen #lesson-workspace { height: 1fr; padding: 0 1; margin-bottom: 1; }
LessonScreen #lesson-list-frame { height: 1fr; padding: 0 1; border: round $primary; background: $surface; }
LessonScreen #lesson-list { height: 1fr; border: none; background: transparent; padding: 0; text-wrap: nowrap; text-overflow: clip; }
LessonScreen #lesson-list:focus { border: none; outline: none; background-tint: transparent; }
LessonScreen #lesson-list > .option-list--option { padding: 0; text-wrap: nowrap; text-overflow: clip; }
LessonScreen #lesson-list > .option-list--option-highlighted,
LessonScreen #lesson-list > .option-list--option-hover-highlighted { background: $primary 16%; color: $text; text-style: bold; }
LessonScreen #lesson-material-frame {height:12; margin-top:1;}
LessonScreen #lesson-materials {height:100%;}
LessonScreen #lesson-materials Button {
    width: 1fr;
    min-width: 0;
    height: auto;
    min-height: 1;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    content-align: left top;
    text-wrap: wrap;
    text-overflow: fold;
    color: $text-accent;
    text-style: underline;
    background: transparent;
}
LessonScreen #lesson-materials Button:hover,
LessonScreen #lesson-materials Button.-active {
    border: none;
    background: $primary 16%;
    text-style: bold underline;
}
LessonScreen #lesson-primary { width: 1fr; height: 1fr; }
LessonScreen #lesson-primary DocumentPane { scrollbar-gutter: stable; }
.lesson-empty { height: auto; color: $text-muted; }
