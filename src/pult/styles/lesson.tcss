LessonScreen { padding: 1 0; }
LessonScreen #lesson-workspace { height: 1fr; padding: 0 1; }
LessonScreen #lesson-navigation { width: 28; height: 1fr; margin-right: 1; }
LessonScreen #lesson-sequence { height: auto; margin-bottom: 1; padding: 1; border: round $primary; background: $surface; }
LessonScreen #lesson-context { height: auto; color: $text-muted; }
LessonScreen #lesson-list-frame { height: 1fr; padding: 1; border: round $primary; background: $surface; }
LessonScreen #lesson-list { height: 1fr; border: none; background: transparent; padding: 0; }
LessonScreen #lesson-list > .option-list--option { padding: 0; }
LessonScreen #lesson-list > .option-list--option-highlighted,
LessonScreen #lesson-list > .option-list--option-hover-highlighted { background: $primary 16%; color: $text; text-style: bold; }
LessonScreen #lesson-primary { width: 1fr; height: 1fr; margin-right: 1; }
LessonScreen #lesson-orientation { width: 44; height: 1fr; }
LessonScreen #lesson-goals { height: 14; margin-bottom: 1; }
LessonPane { height: 1fr; padding: 1 2; background: $surface; border: round $primary; overflow-x: hidden; }
LessonPane:focus { border: round $primary-lighten-2; border-title-color: $primary-lighten-2; }
App.-light-mode LessonPane:focus { border: round $primary-darken-2; border-title-color: $primary-darken-2; }
LessonScreen #lesson-goals-text, LessonScreen #lesson-phases-text { height: auto; }
LessonScreen .lesson-empty, LessonScreen .lesson-caption { height: auto; color: $text-muted; }
LessonMaterial { height: auto; overflow: hidden hidden; }
LessonMaterial Markdown { height: auto; background: transparent; margin: 0; padding: 0; }
LessonMaterial MarkdownH1 { background: transparent; border: none; color: $text-accent; content-align: left middle; }
LessonMaterial MarkdownH2 { color: $text-accent; }
LessonScreen .lesson-task-title { height: auto; text-style: bold; color: $text-accent; border-top: solid $foreground 18%; padding-top: 1; margin-bottom: 1; }
LessonScreen .lesson-solution-title { height: 1; color: $text-muted; margin: 1 0; }
LessonScreen .formula, LessonScreen .figure { overflow: hidden hidden; margin-bottom: 1; }
LessonScreen .formula > Widget, LessonScreen .figure > Widget { width: 100%; height: 100%; overflow: hidden hidden; }
LessonScreen .lesson-fallback { height: auto; color: $text-muted; margin-bottom: 1; }
LessonScreen .lesson-inline-flow { height: auto; min-height: 1; margin-bottom: 1; }
LessonScreen .lesson-inline-row { height: auto; overflow: hidden hidden; align-vertical: middle; }
LessonScreen .lesson-inline-row .formula { margin: 0 1; }
LessonScreen .lesson-inline-text { height: auto; }
