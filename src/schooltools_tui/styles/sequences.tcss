SequenceLibraryScreen #sequence-library {
    height: 1fr;
}

SequenceLibraryScreen #sequence-navigation {
    width: 36;
    padding: 1;
    background: $background;
}

SequenceLibraryScreen #sequence-tree {
    height: 1fr;
    border: round $primary;
    border-title-color: $text-accent;
}

SequenceLibraryScreen #sequence-content {
    width: 1fr;
    padding: 1 2;
}

SequenceLibraryScreen #sequence-preview {
    height: 1fr;
    padding: 1 2;
    background: $surface;
    border: round $primary;
    border-title-color: $text-accent;
}

SequenceLibraryScreen #sequence-tree,
SequenceLibraryScreen #sequence-preview {
    background-tint: transparent;
    outline: none;
    border-title-style: none;
}

SequenceLibraryScreen #sequence-tree:focus,
SequenceLibraryScreen #sequence-preview:focus {
    border: round $primary-lighten-2;
    border-title-color: $primary-lighten-2;
    border-title-style: bold;
    background-tint: transparent;
    outline: none;
}

App.-light-mode SequenceLibraryScreen #sequence-tree:focus,
App.-light-mode SequenceLibraryScreen #sequence-preview:focus {
    border: round $primary-darken-2;
    border-title-color: $primary-darken-2;
}

SequencePreview Markdown {
    padding: 0;
    background: transparent;
}

SequencePreview MarkdownHeader {
    background: transparent;
    color: $text-accent;
    text-style: bold;
    content-align: left middle;
    margin: 1 0;
}

SequencePreview MarkdownHorizontalRule {
    height: 1;
    padding: 0;
    margin: 1 0;
    border-bottom: solid $foreground 18%;
}

SequencePreview MarkdownParagraph {
    margin: 0 0 1 0;
}

SequencePreview MarkdownBulletList {
    margin: 0 0 1 0;
}

SequencePreview MarkdownBlockQuote {
    background: transparent;
    border-left: solid $foreground 25%;
    padding: 0 1;
}
