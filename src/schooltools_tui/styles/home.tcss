MainScreen #main {
    height: 1fr;
}

MainScreen #picker {
    width: 24;
    padding: 1;
    background: $panel;
    border-right: tall $primary;
}

MainScreen .picker-entry {
    height: 3;
    padding: 1 2;
    color: $foreground-muted;
}

MainScreen .picker-entry:hover {
    background: $primary-muted;
    color: $text-primary;
}

MainScreen #content {
    width: 1fr;
    padding: 1 2;
}

MainScreen #page-title {
    height: 3;
    padding-left: 1;
    content-align-vertical: middle;
    color: $text-accent;
    text-style: bold;
}

MainScreen #schedule {
    height: 1fr;
    min-height: 10;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

MainScreen #next-lesson,
MainScreen #school-year {
    height: 5;
    margin-top: 1;
    padding: 1 2;
    background: $surface;
    border: round $secondary;
}
