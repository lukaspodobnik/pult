CancelLessonScreen,
ConfirmUndoScreen,
AddExtraLessonScreen,
SetActiveSequenceScreen {
    align: center middle;
    background: $background 60%;
}

CancelLessonScreen #cancel-lesson-dialog {
    width: 64;
    height: auto;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

ConfirmUndoScreen #confirm-undo-dialog {
    width: 64;
    height: auto;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

AddExtraLessonScreen #add-extra-lesson-dialog {
    width: 72;
    height: auto;
    max-height: 95%;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

SetActiveSequenceScreen #set-active-sequence-dialog {
    width: 72;
    height: auto;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

CancelLessonScreen #cancel-lesson-title {
    height: 3;
    content-align: center middle;
    color: $text-accent;
    text-style: bold;
}

ConfirmUndoScreen #confirm-undo-title {
    height: 3;
    content-align: center middle;
    color: $text-accent;
    text-style: bold;
}

AddExtraLessonScreen #add-extra-lesson-title {
    height: 3;
    content-align: center middle;
    color: $text-accent;
    text-style: bold;
}

SetActiveSequenceScreen #set-active-sequence-title {
    height: 3;
    content-align: center middle;
    color: $text-accent;
    text-style: bold;
}

ConfirmUndoScreen #confirm-undo-message {
    width: 1fr;
    height: 3;
    margin: 1 0;
    text-align: center;
}

CancelLessonScreen #cancel-lesson-comment {
    margin-top: 1;
}

CancelLessonScreen #cancel-lesson-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

ConfirmUndoScreen #confirm-undo-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

AddExtraLessonScreen #complete-next-extra-lesson {
    margin-top: 1;
}

AddExtraLessonScreen #add-extra-lesson-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

SetActiveSequenceScreen #set-active-sequence-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

CancelLessonScreen #cancel-lesson-actions Button {
    margin-left: 1;
}

ConfirmUndoScreen #confirm-undo-actions Button {
    margin-left: 1;
}

AddExtraLessonScreen #add-extra-lesson-actions Button {
    margin-left: 1;
}

SetActiveSequenceScreen #set-active-sequence-actions Button {
    margin-left: 1;
}

LessonProgressBar {
    width: 1fr;
    height: 1;

    & > .lesson-progress-bar--completed {
        color: $success;
    }

    & > .lesson-progress-bar--skipped {
        color: $warning;
    }

    & > .lesson-progress-bar--open {
        color: $surface-lighten-2;
    }
}

SchoolClassView {
    height: 1fr;
}

SchoolClassView #school-class-content {
    height: 1fr;
    padding: 0 1 2 1;
}

SchoolClassView #school-class-title {
    height: 3;
    content-align-vertical: middle;
    color: $text-accent;
    text-style: bold;
}

SchoolClassView .subject-progress {
    height: auto;
    margin-bottom: 2;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

SchoolClassView .subject-title {
    height: 2;
    color: $text-accent;
    text-style: bold;
}

SchoolClassView .next-lesson-label {
    height: 1;
    margin-top: 1;
    color: $foreground-muted;
}

SchoolClassView .next-lesson-title {
    height: auto;
    text-style: bold;
}

SchoolClassView .next-lesson-date,
SchoolClassView .next-lesson-details,
SchoolClassView .next-lesson-empty,
SchoolClassView .empty-sequence-hint {
    height: auto;
    color: $foreground-muted;
}

SchoolClassView .progress-heading {
    height: auto;
    margin-top: 1;
}

SchoolClassView .progress-title {
    width: 1fr;
    height: auto;
}

SchoolClassView .progress-count {
    width: auto;
    min-width: 9;
    height: auto;
    text-align: right;
}

SchoolClassView .subject-progress-heading {
    margin-top: 2;
    text-style: bold;
}

SchoolClassView .subject-progress-bar {
    margin-bottom: 1;
}

SchoolClassView .lesson-capacity {
    height: auto;
    color: $foreground-muted;
}

SchoolClassView .available-periods {
    width: 1fr;
    height: auto;
}

SchoolClassView .lesson-balance {
    width: auto;
    height: auto;
    text-align: right;
    text-style: bold;
}

SchoolClassView .lesson-balance.positive {
    color: $success;
}

SchoolClassView .lesson-balance.negative {
    color: $error;
}

SchoolClassView .lesson-balance.neutral {
    color: $foreground-muted;
}

SchoolClassView .sequence-progress {
    height: auto;
    margin-top: 1;
    padding-left: 1;
}

SchoolClassView .sequence-progress.active {
    color: $text-accent;
}
