

CancelLessonScreen,
AddExtraLessonScreen,
SetActiveSequenceScreen {
    align: center middle;
    background: $background 60%;
}

CancelLessonScreen #cancel-lesson-dialog {
    width: 64;
    height: auto;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

AddExtraLessonScreen #add-extra-lesson-dialog {
    width: 72;
    height: auto;
    max-height: 95%;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

SetActiveSequenceScreen #set-active-sequence-dialog {
    width: 72;
    height: auto;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

CancelLessonScreen #cancel-lesson-title {
    height: 3;
    content-align: center middle;
    color: $text-accent;
    text-style: bold;
}

AddExtraLessonScreen #add-extra-lesson-title {
    height: 3;
    content-align: center middle;
    color: $text-accent;
    text-style: bold;
}

SetActiveSequenceScreen #set-active-sequence-title {
    height: 3;
    content-align: center middle;
    color: $text-accent;
    text-style: bold;
}

CancelLessonScreen #cancel-lesson-comment {
    margin-top: 1;
}

CancelLessonScreen #cancel-lesson-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

AddExtraLessonScreen #complete-next-extra-lesson {
    margin-top: 1;
}

AddExtraLessonScreen #add-extra-lesson-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

SetActiveSequenceScreen #set-active-sequence-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

CancelLessonScreen #cancel-lesson-actions Button {
    margin-left: 1;
}

AddExtraLessonScreen #add-extra-lesson-actions Button {
    margin-left: 1;
}

SetActiveSequenceScreen #set-active-sequence-actions Button {
    margin-left: 1;
}

LessonProgressBar {
    width: 1fr;
    height: 1;

    & > .lesson-progress-bar--completed {
        color: $success;
    }

    & > .lesson-progress-bar--skipped {
        color: $warning;
    }

    & > .lesson-progress-bar--open {
        color: $surface-lighten-2;
    }
}

SchoolClassView {
    height: 1fr;
}

SchoolClassView #school-class-content {
    height: 1fr;
}

SchoolClassView .subject-progress {
    height: 1fr;
    min-height: 34;
    min-width: 120;
}

SchoolClassView .subject-overview,
SchoolClassView .sequence-list,
SchoolClassView .class-next-lesson,
SchoolClassView .lesson-capacity {
    background: $surface;
    border: round $primary;
    border-title-color: $text-accent;
    padding: 0 1;
}

SchoolClassView .subject-overview {
    height: 4;
    margin-bottom: 1;
}

SchoolClassView .total-label {
    height: 1;
}

SchoolClassView .class-dashboard {
    height: 1fr;
}

SchoolClassView .sequence-list {
    width: 3fr;
    height: 1fr;
    margin-right: 1;
}

SchoolClassView .class-details {
    width: 2fr;
    height: 1fr;
}

SchoolClassView .class-next-lesson {
    height: 1fr;
}

SchoolClassView .lesson-capacity {
    height: 1fr;
    min-height: 7;
    margin-top: 1;
}

SchoolClassView .next-lesson-sequence {
    height: auto;
    margin-bottom: 1;
}

SchoolClassView .next-lesson-details {
    margin-top: 1;
}

SchoolClassView .next-lesson-title {
    height: auto;
    text-style: bold;
}

SchoolClassView .next-lesson-date,
SchoolClassView .next-lesson-details,
SchoolClassView .next-lesson-empty,
SchoolClassView .empty-sequence-hint {
    height: auto;
    color: $foreground-muted;
}

SchoolClassView .progress-heading {
    height: 1;
}

SchoolClassView .progress-title {
    width: 1fr;
    height: 1;
}

SchoolClassView .progress-count {
    width: auto;
    min-width: 9;
    height: auto;
    text-align: right;
}

SchoolClassView .capacity-row {
    height: 1;
}

SchoolClassView .capacity-summary {
    height: 1fr;
    padding-top: 1;
}

SchoolClassView .capacity-result {
    height: 1fr;
    text-style: bold;
}

SchoolClassView .capacity-divider {
    height: 1;
    margin: 0;
    color: $foreground-muted;
}

SchoolClassView .capacity-label {
    width: 1fr;
    height: 1fr;
    content-align: left middle;
}

SchoolClassView .capacity-value {
    width: 8;
    height: 1fr;
    content-align: right middle;
}

SchoolClassView .lesson-balance {
    text-style: bold;
}

SchoolClassView .lesson-balance.positive {
    color: $success;
}

SchoolClassView .lesson-balance.negative {
    color: $error;
}

SchoolClassView .lesson-balance.neutral {
    color: $foreground-muted;
}

SchoolClassView .sequence-progress {
    height: auto;
    margin-bottom: 1;
}

SchoolClassView .sequence-progress.active {
    color: $text-accent;
    margin: 1 0;
    padding: 1 0;
}

SchoolClassView .sequence-progress.active .progress-heading,
SchoolClassView .sequence-progress.active .progress-title {
    height: auto;
}
