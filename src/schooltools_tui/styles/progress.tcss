CancelLessonScreen {
    align: center middle;
    background: $background 60%;
}

CancelLessonScreen #cancel-lesson-dialog {
    width: 64;
    height: auto;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

CancelLessonScreen #cancel-lesson-title {
    height: 3;
    content-align: center middle;
    color: $text-accent;
    text-style: bold;
}

CancelLessonScreen #cancel-lesson-comment {
    margin-top: 1;
}

CancelLessonScreen #cancel-lesson-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

CancelLessonScreen #cancel-lesson-actions Button {
    margin-left: 1;
}
