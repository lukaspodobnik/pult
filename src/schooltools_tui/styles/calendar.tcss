

AddClosureScreen {
    align: center middle;
    background: $background 60%;
}

AddClosureScreen #add-closure-dialog {
    width: 68;
    height: auto;
    padding: 2 3;
    background: $surface;
    border: round $primary;
}

AddClosureScreen #add-closure-title {
    height: 3;
    content-align: center middle;
    color: $text-accent;
    text-style: bold;
}

AddClosureScreen .closure-field-label {
    height: 2;
    margin-top: 1;
    color: $foreground-muted;
}

AddClosureScreen #closure-scope {
    width: 1fr;
}

AddClosureScreen #add-closure-actions {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

AddClosureScreen #add-closure-actions Button {
    margin-left: 1;
}

EditClosuresScreen #edit-closures-screen {
    height: 1fr;
    padding: 1 2;
}

EditClosuresScreen #closures {
    height: 1fr;
    min-height: 8;
    border: round $primary;
    border-title-color: $text-accent;
}
