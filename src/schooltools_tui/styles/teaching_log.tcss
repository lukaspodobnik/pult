TeachingLogScreen #teaching-log-screen {
    height: 1fr;
}

TeachingLogScreen #teaching-log-navigation {
    width: 28;
    padding: 1;
    height: 1fr;
    background: $panel;
}

TeachingLogScreen #teaching-log-class-picker {
    height: 1fr;
    border: round $primary;
    border-title-color: $text-accent;
    background: $panel;
}

TeachingLogScreen #teaching-log-content {
    width: 1fr;
    height: 1fr;
    margin: 1 2;
    border: round $primary;
    border-title-color: $text-accent;
}

TeachingLogView {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

TeachingLogView .teaching-log-entry {
    height: auto;
    margin-bottom: 1;
    padding: 1 2;
    background: $surface;
    border-left: thick $primary;
}

TeachingLogView .teaching-log-entry.skipped {
    border-left: thick $warning;
}

TeachingLogView .teaching-log-entry.cancelled {
    border-left: thick $error;
}

TeachingLogView .teaching-log-date-row {
    height: auto;
}

TeachingLogView .teaching-log-date {
    width: 1fr;
    height: auto;
    text-style: bold;
}

TeachingLogView .teaching-log-period {
    width: auto;
    height: auto;
    color: $foreground-muted;
}

TeachingLogView .teaching-log-sequence,
TeachingLogView .teaching-log-lesson,
TeachingLogView .teaching-log-kind,
TeachingLogView .teaching-log-comment,
TeachingLogScreen .teaching-log-empty {
    height: auto;
}

TeachingLogView .teaching-log-sequence {
    margin-top: 1;
    color: $text-accent;
}

TeachingLogView .teaching-log-lesson {
    text-style: bold;
}

TeachingLogView .teaching-log-kind {
    color: $foreground-muted;
}

TeachingLogView .teaching-log-comment {
    margin-top: 1;
    padding-left: 1;
    border-left: solid $foreground-muted;
}

TeachingLogView .teaching-log-empty,
TeachingLogScreen .teaching-log-empty {
    padding: 1 2;
    color: $foreground-muted;
}
