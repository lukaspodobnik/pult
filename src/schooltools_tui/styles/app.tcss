Screen {
    background: $background;
    color: $foreground;
}

ConfirmationScreen {
    align: center middle;
    background: $background 60%;
}

ConfirmationScreen .confirmation-dialog {
    width: 68;
    max-width: 95%;
    height: auto;
    min-height: 13;
    padding: 1 2;
    border: round $primary;
    border-title-color: $text-accent;
    background: $surface;
}

ConfirmationScreen .confirmation-message {
    height: auto;
}

ConfirmationScreen .confirmation-actions {
    height: 1;
    margin-top: 2;
    align-horizontal: right;
}

ConfirmationScreen .confirmation-actions Button {
    margin-left: 1;
    height: 1;
    min-width: 0;
    width: auto;
    border: none;
    padding: 0 2;
}

Header {
    background: $panel;
}

Footer {
    background: $panel;
}

SchooltoolsFooter FooterKey {
    margin-right: 1;
}

SchooltoolsFooter .footer-spacer {
    width: 1fr;
    height: 1;
}

SchooltoolsFooter .navigation-spacer {
    max-width: 8;
}

SchooltoolsFooter FooterKey.quit-key {
    dock: right;
    margin-right: 0;
    margin-left: 2;
}

SchooltoolsFooter FooterKey.balanced-quit {
    dock: none;
    margin-left: 0;
}

.management-actions {
    height: 1;
    margin-top: 1;
}

.management-actions Button {
    height: 1;
    min-width: 0;
    width: auto;
    border: none;
    padding: 0 2;
    margin-right: 1;
}

.management-actions Button:last-child {
    margin-right: 0;
}

.management-actions .action-spacer {
    width: 1fr;
    height: 1;
}
