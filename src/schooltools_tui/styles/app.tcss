Screen {
    background: $background;
    color: $foreground;
}

ConfirmationScreen {
    align: center middle;
    background: $background 60%;
}

ConfirmationScreen .confirmation-dialog {
    width: 68;
    max-width: 95%;
    height: auto;
    min-height: 13;
    padding: 1 2;
    border: round $primary;
    border-title-color: $text-accent;
    background: $surface;
}

ConfirmationScreen .confirmation-message {
    height: auto;
}

ConfirmationScreen .confirmation-actions {
    height: 1;
    margin-top: 2;
    align-horizontal: right;
}

ConfirmationScreen .confirmation-actions Button {
    margin-left: 1;
    height: 1;
    min-width: 0;
    width: 16;
    border: none;
    padding: 0 2;
}

Header {
    background: $panel;
}

SchooltoolsModalScreen {
    align: center middle;
    background: $background 60%;
}

FormDialog {
    width: 68;
    max-width: 95%;
    height: auto;
    min-height: 13;
    max-height: 95%;
    padding: 1 2;
    border: round $primary;
    border-title-color: $text-accent;
    background: $surface;
}

FormDialog.wide {
    width: 76;
}

FormDialog .form-fields {
    height: auto;
    max-height: 60vh;
    overflow-x: hidden;
}

FormDialog .field-label,
FormDialog .closure-field-label {
    height: 1;
    margin-top: 1;
    color: $foreground-muted;
}

FormDialog .form-context {
    height: auto;
    margin-bottom: 1;
    text-style: bold;
}

FormDialog .form-hint {
    height: auto;
    color: $foreground-muted;
}

FormDialog .form-actions {
    height: 1;
    margin-top: 2;
    align-horizontal: right;
}

FormDialog .form-actions Button {
    width: 16;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin-left: 1;
}

FormDialog .form-action-spacer {
    width: 1fr;
    height: 1;
}

FormDialog .date-fields {
    height: auto;
}

FormDialog .date-field {
    width: 1fr;
    height: auto;
}

FormDialog .date-field:first-child {
    margin-right: 2;
}

FormDialog #subjects {
    height: 8;
    margin: 1 0;
    border: round $primary;
    border-title-color: $text-accent;
}

FormDialog #complete-next-extra-lesson {
    margin-top: 1;
}

Footer {
    background: $panel;
}

SchooltoolsFooter FooterKey {
    margin-right: 1;
}

SchooltoolsFooter .footer-spacer {
    width: 1fr;
    height: 1;
}

SchooltoolsFooter .navigation-spacer {
    max-width: 8;
}

SchooltoolsFooter FooterKey.quit-key {
    dock: right;
    margin-right: 0;
    margin-left: 2;
}

SchooltoolsFooter FooterKey.balanced-quit {
    dock: none;
    margin-left: 0;
}

.management-actions {
    height: 1;
    margin-top: 1;
}

.management-actions Button {
    height: 1;
    min-width: 0;
    width: auto;
    border: none;
    padding: 0 2;
    margin-right: 1;
}

.management-actions Button:last-child {
    margin-right: 0;
}

.management-actions .action-spacer {
    width: 1fr;
    height: 1;
}
